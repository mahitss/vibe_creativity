NODE_ENV=development
NEXT_PUBLIC_APP_NAME=OMNIA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

BETTER_AUTH_SECRET=replace-with-32-plus-characters
BETTER_AUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://omnia:omnia@localhost:5432/omnia
REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=omnia

MINDS_AGENT_PROVIDER=local
MINDS_AGENT_MODEL=omnia-minds-agent
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-5

